{
  "name": "mesnier",
  "version": "0.1.0",
  "private": true,
  "description": "面向 Work 与 Coding 的 Agent 工作台",
  "author": "Mesnier",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:app": "node scripts/build-app.mjs",
    "build:runtime": "npm run build --workspace @mesnier/runtime",
    "build": "npm run build:app && npm run build:runtime",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/host/*.test.ts",
    "test:runtime": "node scripts/test-runtime.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "start": "electron .",
    "test:probe": "node --test tests/acceptance/probe-regressions.test.mjs",
    "test:mutations": "node tests/acceptance/check-regression-mutations.mjs && node --import tsx tests/acceptance/check-host-mutations.mjs"
  },
  "dependencies": {
    "@mesnier/shared": "0.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "lucide-react": "^0.577.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "41.0.3",
    "electron-builder": "26.8.1",
    "esbuild": "^0.27.4",
    "playwright-core": "1.59.1",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vite": "8.0.2"
  },
  "build": {
    "appId": "app.mesnier.desktop",
    "productName": "Mesnier",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/kimi/LICENSE",
        "to": "licenses/Kimi-Code-MIT.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/Electron-LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/Chromium-LICENSES.html"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "notarize": false,
      "icon": "build/icon.icns"
    }
  }
}
